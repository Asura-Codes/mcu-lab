# EditorConfig for Embedded Development Templates
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C/C++ source and header files
[*.{c,h,cpp,hpp,cc,hh}]
indent_style = space
indent_size = 4
max_line_length = 100

# Assembly files
[*.{s,S,asm}]
indent_style = space
indent_size = 4

# CMake files
[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

# Makefiles require tabs
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

# Linker scripts
[*.ld]
indent_style = space
indent_size = 4

# Configuration files
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# ESP-IDF specific
[sdkconfig]
indent_style = space
indent_size = 4

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# Markdown
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# Python (for ESP-IDF scripts)
[*.py]
indent_style = space
indent_size = 4
max_line_length = 120
