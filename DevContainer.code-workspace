  "settings": {
    // General Editor Settings
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [
      80,
      120
    ],
    "editor.wordWrap": "off",
    "editor.trimAutoWhitespace": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.encoding": "utf8",
    // File Associations
    "files.associations": {
      "*.c": "c",
      "*.h": "c",
      "*.cpp": "cpp",
      "*.hpp": "cpp",
      "*.s": "arm",
      "*.S": "arm",
      "*.ld": "linkerscript",
      "*.cfg": "properties",
      "sdkconfig": "properties",
      "CMakeLists.txt": "cmake",
      "Makefile": "makefile"
    },
    // C/C++ Extension Settings
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.intelliSenseMode": "gcc-arm",
    "C_Cpp.default.compilerPath": "/usr/bin/arm-none-eabi-gcc",
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.autoAddFileAssociations": true,
    "C_Cpp.enhancedColorization": "enabled",
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 4, ColumnLimit: 100 }",
    // Terminal Settings
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.copyOnSelection": true,
    // Search Settings
    "search.exclude": {
      "**/build": true,
      "**/build-*": true,
      "**/.pio": true,
      "**/node_modules": true,
      "**/.git": true,
      "**/CMakeFiles": true,
      "**/*.elf": true,
      "**/*.bin": true,
      "**/*.hex": true,
      "**/*.map": true,
      "**/*.o": true,
      "**/*.a": true,
      "**/*.d": true
    },
    // Files to exclude from the explorer
    "files.exclude": {
      "**/.git": true,
      "**/.DS_Store": true,
      "**/CMakeFiles": false,
      "**/*.o": true,
      "**/*.d": true
    },
    // Git Settings
    "git.ignoreLimitWarning": true,
    "git.detectSubmodules": true,
    "git.autofetch": true,
    // CMake Settings
    "cmake.configureOnOpen": false,
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.generator": "Ninja",
    "cmake.saveBeforeBuild": true,
    "cmake.clearOutputBeforeBuild": true,
    // ESP-IDF Settings
    "idf.port": "/dev/ttyUSB0",
    "idf.flashType": "UART",
    "idf.openOcdConfigs": [
      "interface/ftdi/esp32_devkitj_v1.cfg",
      "board/esp32-wrover-kit-3.3v.cfg"
    ],
    // Cortex-Debug Settings
    // arm-zephyr-eabi-gdb is the Zephyr SDK GDB (symlinked to /usr/bin/ by Dockerfile).
    // armToolchainPath /usr/bin/ finds both arm-none-eabi-nm/objdump (gcc-arm-none-eabi)
    // and riscv32-esp-elf-nm/objdump / xtensa-esp-elf-nm/objdump (ESP toolchain symlinks).
    "cortex-debug.gdbPath": "arm-zephyr-eabi-gdb",
    "cortex-debug.armToolchainPath": "/usr/bin/",
    "cortex-debug.showRTOS": true,
    "cortex-debug.variableUseNaturalFormat": true,
    // Python interpreter for devcontainer
    "python.defaultInterpreterPath": "/usr/bin/python3",
    // Workspace Telemetry
    "telemetry.telemetryLevel": "off"
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.cpptools",
      "ms-vscode.cmake-tools",
      "marus25.cortex-debug",
