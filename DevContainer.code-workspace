  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build All ESP32 Templates",
        "type": "shell",
        "command": "bash",
        "args": [
          "-c",
          "source /opt/esp/idf/export.sh && for dir in esp32 esp32-c3 esp32-c6 esp32-s2 esp32-s3 esp32-wroom32; do echo \"Building $dir...\"; cd templates/$dir && idf.py build && cd ../..; done"
        ],
        "options": {
          "cwd": "${workspaceFolder:📁 Root}"
        },
        "problemMatcher": [],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared",
          "showReuseMessage": true,
          "clear": false
        },
        "detail": "Build all ESP32 family templates (ESP-IDF)"
      },
      {
        "label": "Build All Arduino Templates",
        "type": "shell",
        "command": "bash",
        "args": [
          "-c",
          "for dir in esp8266 esp8266-d1mini arduino-uno; do echo \"Building $dir...\"; cd templates/$dir && ./build.sh && cd ../..; done"
        ],
        "options": {
          "cwd": "${workspaceFolder:📁 Root}"
        },
        "problemMatcher": [],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared",
          "showReuseMessage": true,
          "clear": false
        },
        "detail": "Build all Arduino-based templates (ESP8266 C++ and AVR)"
      },
      {
        "label": "Build All Pico Templates",
        "type": "shell",
        "command": "bash",
        "args": [
          "-c",
          "for dir in rp2040 rp2350; do echo \"Building $dir...\"; mkdir -p templates/$dir/build && cd templates/$dir/build && cmake .. && make -j4 && cd ../../..; done"
        ],
        "options": {
          "cwd": "${workspaceFolder:📁 Root}"
        },
        "problemMatcher": [
          "$gcc"
        ],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared",
          "showReuseMessage": true,
          "clear": false
        },
        "detail": "Build all Raspberry Pi Pico templates"
      },
      {
        "label": "Build All STM32 Templates",
        "type": "shell",
        "command": "bash",
        "args": [
          "-c",
          "for pair in 'stm32_min_dev:stm32f103' 'blackpill_f411ce:stm32f411' 'nucleo_f412zg:stm32f412' 'weact_stm32g431_core:stm32g431' 'nucleo_h503rb:stm32h503'; do board=${pair%%:*}; dir=${pair##*:}; echo \"Building $dir ($board)...\"; cmake -B templates/$dir/build -DBOARD=$board templates/$dir && cmake --build templates/$dir/build -j4 || echo \"FAILED: $dir\"; done"
        ],
        "options": {
          "cwd": "${workspaceFolder:📁 Root}"
        },
        "problemMatcher": [
          "$gcc"
        ],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared",
          "showReuseMessage": true,
          "clear": false
        },
        "detail": "Build all STM32 templates (Zephyr)"
      },
      {
        "label": "Build All Templates",
        "dependsOn": [
          "Build All ESP32 Templates",
          "Build All Arduino Templates",
          "Build All Pico Templates",
          "Build All STM32 Templates"
