        "name": "Debug STM32F103 (Cortex-M3)",
        "type": "cortex-debug",
        "request": "launch",
        "cwd": "${workspaceFolder:STM32F103 (ARM Cortex-M3)}",
        "servertype": "external",
        "gdbTarget": "host.docker.internal:3333",
        "gdbPath": "arm-zephyr-eabi-gdb",
        "toolchainPrefix": "arm-zephyr-eabi",
        "executable": "${workspaceFolder:STM32F103 (ARM Cortex-M3)}/build/zephyr/zephyr.elf",
        "device": "STM32F103C8",
        "runToEntryPoint": "main",
        "showDevDebugOutput": "none",
