                "/opt/arduino/packages/esp8266/hardware/esp8266/3.1.2/cores/esp8266",
                "/opt/arduino/packages/esp8266/hardware/esp8266/3.1.2/variants/d1_mini",
                "/opt/arduino/packages/esp8266/hardware/esp8266/3.1.2/tools/sdk/include",
                "/opt/arduino/packages/esp8266/hardware/esp8266/3.1.2/tools/sdk/lwip2/include",
                "/opt/arduino/packages/esp8266/hardware/esp8266/3.1.2/libraries/**"
            ],
            "defines": [
                "ESP8266",
                "ARDUINO=10819",
                "ARDUINO_ARCH_ESP8266",
                "ARDUINO_ESP8266_D1_MINI",
                "F_CPU=80000000L"
            ],
            "compilerPath": "/opt/arduino/packages/esp8266/tools/xtensa-lx106-elf-gcc/3.1.0-gcc10.3-e5f9fec/bin/xtensa-lx106-elf-g++",
            "cStandard": "c11",
