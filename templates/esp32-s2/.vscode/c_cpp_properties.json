{
  "configurations": [
    {
      "name": "ESP32-S2",
      "compilerPath": "/opt/esp/tools/xtensa-esp-elf/esp-15.2.0_20251204/xtensa-esp-elf/bin/xtensa-esp32s2-elf-gcc",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "intelliSenseMode": "linux-gcc-x64",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/main",
        "${workspaceFolder}/build/**",
        "${workspaceFolder}/build/config",
        "${workspaceFolder}/build/bootloader/config"
      ],
      "defines": [],
      "browse": {
        "path": [
          "${workspaceFolder}/**",
          "/opt/esp/idf/components/**"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4
}
