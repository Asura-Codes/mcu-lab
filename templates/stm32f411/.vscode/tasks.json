{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32F411: Configure CMake",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/build",
                "-DBOARD=blackpill_f411ce",
                "${workspaceFolder}"
            ],
            "problemMatcher": [],
            "detail": "Configure CMake build for STM32F411 (BlackPill, Zephyr)"
        },
        {
            "label": "STM32F411: Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "-j4"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "STM32F411: Configure CMake"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build STM32F411 firmware (Zephyr)"
        },
        {
            "label": "STM32F411: Menuconfig",
            "type": "shell",
            "command": "west",
            "args": [
                "build",
                "-b",
                "blackpill_f411ce",
                "-s",
                ".",
                "-t",
                "menuconfig"
            ],
            "problemMatcher": [],
            "detail": "Open menuconfig for STM32F411 (Zephyr)"
        },
        {
            "label": "STM32F411: Clean",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "${workspaceFolder}/build"
            ],
            "problemMatcher": [],
            "detail": "Remove build directory"
        }
    ]
}
