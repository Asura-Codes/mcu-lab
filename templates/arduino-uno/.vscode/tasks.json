{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Arduino Uno: Build",
            "type": "shell",
            "command": "${workspaceFolder}/build.sh",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build using Arduino CLI"
        },
        {
            "label": "Arduino Uno: Clean",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "${workspaceFolder}/build"
            ],
            "problemMatcher": [],
            "detail": "Clean build artifacts"
        }
    ]
}
