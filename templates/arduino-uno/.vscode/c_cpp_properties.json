{
    "configurations": [
        {
            "name": "Arduino Uno",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/src",
                "/opt/arduino/packages/arduino/hardware/avr/1.8.7/cores/arduino",
                "/opt/arduino/packages/arduino/hardware/avr/1.8.7/variants/standard",
                "/opt/arduino/packages/arduino/hardware/avr/1.8.7/libraries/**",
                "/opt/arduino/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/avr/include"
            ],
            "defines": [
                "ARDUINO=10607",
                "ARDUINO_AVR_UNO",
                "ARDUINO_ARCH_AVR",
                "__AVR_ATmega328P__",
                "F_CPU=16000000UL"
            ],
            "compilerPath": "/opt/arduino/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/bin/avr-gcc",
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "gcc-x64"
        }
    ],
    "version": 4
}
