#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		led0 = &weact_led_blue;
		sw0 = &weact_button_key;
	};

	leds {
		compatible = "gpio-leds";
		weact_led_blue: led_0 {
			/* WeAct STM32F4 64-pin CoreBoard: blue LED on PB2 */
			gpios = <&gpiob 2 GPIO_ACTIVE_HIGH>;
			label = "WeAct Blue LED";
		};
	};

	buttons {
		compatible = "gpio-keys";
		weact_button_key: button_0 {
			/* WeAct STM32F4 64-pin CoreBoard: KEY button on PA0 */
			gpios = <&gpioa 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "WeAct KEY";
		};
	};

	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,flash = &flash0;
	};
};

/* STM32F412RET6 provides 512 KiB internal flash. */
&flash0 {
	reg = <0x08000000 0x00080000>;
};

&zephyr_udc0 {
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		status = "okay";
	};
};

/*
 * Nucleo-F412ZG board config expects HSE bypass from ST-LINK MCO.
 * WeAct boards do not provide that clock, so boot hangs waiting for HSE.
 * Force RCC to use HSI as PLL source.
 */
/ {
	clocks {
		clk-hse {
			status = "disabled";
		};

		clk-hsi {
			status = "okay";
		};

		pll {
			/* 16 MHz HSI -> 96 MHz SYSCLK, 48 MHz USB clock via PLLQ */
			div-m = <16>;
			mul-n = <384>;
			div-p = <4>;
			div-q = <8>;
			clocks = <&clk_hsi>;
			status = "okay";
		};
	};
};
